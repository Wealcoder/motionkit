# Copy this file to .env and set your OS-native absolute paths.
# scripts/copy-to-editor.js reads these to sync built animation scripts into
# the editor's static folder on each build. Works on Windows and Linux.
#
# MOTIONKIT_CONNECTOR_PATH is optional — it defaults to this repo when unset.

MOTIONKIT_CONNECTOR_PATH=/path/to/gsap-animation-builder-for-wordpress
MOTIONKIT_EDITOR_PATH=/path/to/motionkit-editor

# Verbose customEngine animation logging in the browser console — per-tween
# start ("MOTIONKIT GSAP ENGINE") + completion logs and step-apply tracing.
# Read at runtime by PHP (Helper::is_dev_log) on every request and passed to the
# frontend as wcfanimb.dev_log, so a change takes effect on the next page load —
# no rebuild. .env is gitignored and absent from releases, so this is always
# false on customer installs. Editor preview logs regardless.
# Also still read at build time (__MKIT_DEV_LOG__) as a fallback; the inspector
# (window.motionkit) remains build-time only and does need a rebuild.
# Manual override, wins over everything: window.__mkitRunLog = true/false.
MOTIONKIT_DEV_LOG=false

# Windows example:
# MOTIONKIT_CONNECTOR_PATH=D:\projects\gsap-animation-builder-for-wordpress
# MOTIONKIT_EDITOR_PATH=D:\projects\motionkit-editor
