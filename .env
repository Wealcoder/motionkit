# Paths used by scripts/copy-to-editor.js to sync built animation scripts into
# the editor server's static folder on every webpack rebuild. Set these to your
# OS-native absolute paths (Windows or Linux). The connector path is optional —
# it defaults to this repo when unset.

MOTIONKIT_CONNECTOR_PATH=/home/wealcoder/Projects/gsap-animation-builder-for-wordpress
MOTIONKIT_EDITOR_PATH=/home/wealcoder/Projects/motionkit-editor

# Windows example:
# MOTIONKIT_CONNECTOR_PATH=D:\projects\gsap-animation-builder-for-wordpress
# MOTIONKIT_EDITOR_PATH=D:\projects\motionkit-editor
