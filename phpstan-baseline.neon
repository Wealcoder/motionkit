parameters:
	ignoreErrors:
		-
			message: "#^Method MotionKit\\\\Auth\\\\ConnectPage\\:\\:collect_animation_records\\(\\) should return array\\<int, array\\{store_type\\: string, option\\: string, id\\: int, title\\: string, type_label\\: string, modified\\: string, edit_url\\: string\\|null, permalink\\: string\\|null\\}\\> but returns array\\<int, array\\{store_type\\: 'option'\\|'post_meta'\\|'term_meta', option\\: mixed, id\\: int, title\\: mixed, type_label\\: mixed, modified\\: mixed\\}\\>\\.$#"
			count: 1
			path: includes/Auth/ConnectPage.php

		-
			message: "#^Strict comparison using \\=\\=\\= between string and false will always evaluate to false\\.$#"
			count: 1
			path: includes/Auth/OAuthHandler.php

		-
			message: "#^Else branch is unreachable because ternary operator condition is always true\\.$#"
			count: 3
			path: includes/Frontend/Frontend.php

		-
			message: "#^Method MotionKit\\\\Plugin\\:\\:should_skip_init\\(\\) is unused\\.$#"
			count: 1
			path: includes/Plugin.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 1
			path: includes/RestApi/RestApi.php
